docRoot                   /var/www/vhosts/goldenfarm.com.vn
vhDomain                  goldenfarm.com.vn
vhAliases                 www.goldenfarm.com.vn, canhdongvang.com, www.canhdongvang.com
adminEmails               it@goldenfarm.com.vn
enableGzip                1
enableIpGeo               0

errorlog logs/$VH_NAME.error.log {
  logLevel                WARN
  rollingSize             10M
  keepDays                7
}

accesslog logs/$VH_NAME.access.log {
  logFormat               "%h %l %u %t \"%r\" %>s %b"
  rollingSize             10M
  keepDays                7
}

index  {
  useServer               0
  indexFiles              index.php, index.html
}

scripthandler  {
  add                     lsapi:lsphp php
}

extprocessor lsphp {
  type                    lsapi
  address                 uds://tmp/lshttpd/lsphp81.sock
  maxConns                60
  env                     PHP_LSAPI_CHILDREN=60
  env                     LSAPI_AVOID_FORK=0
  env                     LSAPI_EXTRA_HEADERS=1
  env                     LSAPI_MAX_IDLE=30
  env                     LSAPI_MAX_IDLE_CHILDREN=5
  initTimeout             300
  retryTimeout            0
  persistConn             1
  respBuffer              0
  autoStart               2
  path                    /usr/local/lsws/lsphp81/bin/lsphp
  backlog                 100
  instances               1
  memSoftLimit            2147483648
  memHardLimit            3221225472
}

rewrite  {
  enable                  1
  autoLoadHtaccess        1
}

module cache {
storagePath             /usr/local/lsws/cachedata/goldenfarm
checkPrivateCache       1
checkPublicCache        1
maxCacheObjSize         10485760
maxStaleAge             200
qsCache                 0
reqCookieCache          0
respCookieCache         0
enableCache             1
expireInSeconds         3600
enablePrivateCache      0
noCacheUrl              /wp-admin
noCacheUrl              /wp-login.php
noCacheUrl              /wp-cron.php
noCacheUrl              /cart
noCacheUrl              /checkout
noCacheUrl              /my-account
  ls_enabled              1
}